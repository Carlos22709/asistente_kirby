{
  "expo": {
    "name": "Kirby Assistant",
    "slug": "kirby-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kirbyassistant",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#F58BB4",
          "defaultChannel": "recordatorios"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.kirbyassistant.mobile"
    },
    "ios": {
      "bundleIdentifier": "com.kirbyassistant.mobile"
    }
  }
}
